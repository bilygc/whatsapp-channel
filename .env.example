# Copy to .env and fill in real values. Never commit .env.
# NewsData.io free API key (commercial-use-safe pick per the plan). Optional:
# without it, `npm run fetch` skips the NewsData source and still runs RSS.
NEWSDATA_API_KEY=

# OpenRouter API key (M2 writer). Get one at https://openrouter.ai/keys.
OPENROUTER_API_KEY=

# LLM model for the writer (default: NVIDIA Nemotron 3.5 Super VL, free tier).
# Override to pin or change the model; must be a valid OpenRouter model slug.
# LLM_MODEL=nvidia/nemotron-3.5-super-vl:free

# Token budget per LLM caption call (default: 6000). The default model emits
# English chain-of-thought before the Spanish caption, so the budget must fit
# reasoning (~1500+ tokens) plus the caption. Raise on repeated
# `response truncated ... (finish_reason length)` failures; lower to save quota.
# LLM_MAX_TOKENS=6000

# Inter-article pacing for the writer (default: 6000 ms, with +/-20% jitter).
# Spreads the two LLM calls per article under OpenRouter's free-tier 20 req/min
# (and 1000/day) limits without switching off :free models. Set to 0 to disable.
# Each article also waits >=1s between its caption and X-post calls.
# LLM_INTER_ARTICLE_DELAY_MS=6000

# Image model for manual `/img` generation (default: meta/muse-image).
# Only set to override; the default is used when this is unset.
# IMAGE_MODEL=meta/muse-image

# Telegram delivery bot (M3). Token from @BotFather; chat id via `npm run telegramSetup`.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional override for the SQLite file (default: data/whatsapp-channel.db).
# DB_PATH=
