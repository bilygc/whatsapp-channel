# Copy to .env and fill in real values. Never commit .env.
# NewsData.io free API key (commercial-use-safe pick per the plan). Optional:
# without it, `npm run fetch` skips the NewsData source and still runs RSS.
NEWSDATA_API_KEY=

# OpenRouter API key (M2 writer). Get one at https://openrouter.ai/keys.
OPENROUTER_API_KEY=

# LLM model for the writer (default: NVIDIA Nemotron 3.5 Super VL, free tier).
# Override to pin or change the model; must be a valid OpenRouter model slug.
# LLM_MODEL=nvidia/nemotron-3.5-super-vl:free

# Optional override for the SQLite file (default: data/whatsapp-channel.db).
# DB_PATH=
